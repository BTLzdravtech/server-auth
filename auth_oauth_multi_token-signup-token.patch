+    def test_signin_with_signup_token(self):
+        # an existing user without an oauth_uid follows a reset link and
+        # signs in with the provider: the link binds the account
+        user = self.user_model.create({"name": "Jane Doe", "login": "janedoe"})
+        user.partner_id.signup_prepare(signup_type="reset")
+        token = user.partner_id._generate_signup_token()
+        validation = {"user_id": "oauth_uid_janedoe", "email": "janedoe"}
+        params = self._fake_params(state=json.dumps({"t": token}))
+        login = (
+            self.env["res.users"]
+            .sudo()
+            ._auth_oauth_signin(self.provider_google.id, validation, params)
+        )
+        self.assertEqual(login, "janedoe")
+        self.assertEqual(user.oauth_uid, "oauth_uid_janedoe")
+        self.assertEqual(len(user.oauth_access_token_ids), 1)
